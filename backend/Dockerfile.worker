# Multi-stage build for Go Ingest Worker
FROM golang:1.24-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/cbt-worker ./cmd/worker

# Lightweight runtime
FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata
ENV TZ=Asia/Jakarta

WORKDIR /root/
COPY --from=builder /app/cbt-worker .

CMD ["./cbt-worker"]
