# Multi-stage build for Go API Server
FROM golang:1.24-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/cbt-server ./cmd/server

# Lightweight runtime
FROM alpine:3.20

RUN apk --no-cache add ca-certificates tzdata
ENV TZ=Asia/Jakarta

WORKDIR /root/
COPY --from=builder /app/cbt-server .

EXPOSE 8080
CMD ["./cbt-server"]
